# ── Base de données PostgreSQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mspr_db
DB_USER=mspr_user
DB_PASSWORD=mspr_password

# ── pgAdmin (interface d'administration BDD) ───────────────────────────────
PGADMIN_MAIL=admin@example.com
PGADMIN_PASS=admin123

# ── ETL (optionnel — profil "etl" uniquement) ──────────────────────────────
# Dossier contenant les données brutes GTFS, Back on Track, aéroports, SNCF
RAW_DATA_DIR=/chemin/vers/data/raw
STAGING_DATA_DIR=/chemin/vers/data/staging
INCREMENTAL_LOAD=false
TARGET_COUNTRIES=FR,DE,ES,IT,BE,NL,AT,CH
